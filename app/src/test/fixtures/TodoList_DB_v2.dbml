// Copy the entire file into the DBML editor at https://dbdiagram.io/
// Relational Room/SQLite schema from v2. Firestore is documented separately.
// Partial unique indexes are documented as notes, not replaced by stricter full indexes.
// Online writes: Cloud Functions callable is the only business write gateway;
// Firestore SDK listeners/snapshots are read-only on clients. Admin SDK handlers
// explicitly validate Firebase token, permissions, revision and operation_id.
// Conflict policy: preserve draft base_revision; reject stale UPDATE with
// REVISION_CONFLICT and current data, retaining the draft for user review.
// Never relabel stale contents with the latest revision or use last-write-wins.
// Coalesce only unsent UPDATEs while preserving their original base_revision;
// freeze SENDING commands and serialize dependent commands until own ACK.
// Never advance a base across changes accepted from another device.
// Trash: CATEGORY/TASK/SUBTASK have deleted_at. NULL is active. Setting it hides
// descendants without modifying their own deletion state. Restore requires an
// active parent, and restoring a category must acquire its active name key.
// Only OWNER can purge CATEGORY/TASK/SUBTASK. OWNER/EDITOR can trash or restore
// TASK/SUBTASK. CATEGORY trash and restore are OWNER only. Physical DELETE
// retains routing only; do not use cascades for moving to the trash.
// Reconcile complete server snapshots, retain valid local pending CREATEs and
// suppress pending purge routes. Use receipts/creation keys to prevent replay
// and batch cleanup with a durable lock before acknowledging a purge.
Project TodoList_v2 {
  database_type: 'SQLite'
  Note: 'MVC + Repository; sign in only with email and password through Firebase Authentication. Firebase UID identifies accounts. UUID identifies category/task business objects; timestamps are epoch milliseconds. Task participation is voluntary self-join by ACTIVE OWNER/EDITOR; multiple participants may join the same task.'
}

Table users {
  uid text [pk, not null, note: 'Firebase Authentication UID. No password stored.']
  email text [not null]
  email_key text [not null]
  full_name text [not null]
  email_verified integer [not null, default: 0]
  avatar_url text
  server_updated_at integer

  checks {
    `email_verified IN (0,1)`
  }

  Note: 'Firebase Authentication handles email/password registration, login and password reset. The application stores profile fields and Firebase UID only; no username login, local password or password hash is stored. After registration send verification email; allow resend, reload user and refresh ID token on return. Unverified accounts may use personal features; invitation acceptance requires verified email from a valid Firebase token, never the client profile flag.'
}

Table categories {
  Note: 'The private default category uses a UUID derived from owner_uid and an empty name_key. User-defined categories have a nonempty name_key.'
  id text [pk, not null, note: 'UUID generated by application']
  owner_uid text [not null]
  name text [not null]
  name_key text [not null]
  color text
  icon text [note: 'Optional category icon key. NULL displays the default plus icon.']
  created_at integer [not null]
  client_updated_at integer [not null]
  server_updated_at integer
  deleted_at integer [note: 'NULL = active; category/task/subtask use trash and restore. Invitations and reminders also retain this nullable column for Room v3 compatibility.']
  revision integer [not null, default: 0]
  server_seq integer [not null, default: 0]

  Note: 'Name uniqueness applies per owner to active categories (partial unique SQLite index WHERE deleted_at IS NULL). Exactly one ACTIVE OWNER is enforced by backend transaction. Only a permanent purge removes this row and cascades.'
}

Table category_members {
  category_id text [not null]
  user_uid text [not null]
  role text [not null]
  status text [not null, default: 'ACTIVE']
  joined_at integer [not null]
  server_updated_at integer
  revision integer [not null, default: 0]
  server_seq integer [not null, default: 0]

  indexes {
    (category_id, user_uid) [pk]
    (user_uid, status, category_id) [name: 'idx_members_user']
  }

  checks {
    `role IN ('OWNER','EDITOR','VIEWER')`
    `status IN ('ACTIVE','REMOVED')`
  }

  Note: 'CREATE UNIQUE INDEX uq_one_active_owner ON category_members(category_id)  WHERE role=\'OWNER\' AND status=\'ACTIVE\'; When status becomes REMOVED, role becomes VIEWER, or this membership row is deleted, physically remove this member\'s task_participants rows and stale pending joins in the same Repository/backend transaction. Tasks persist. FK CASCADE covers membership DELETE; role/status UPDATE requires explicit participant cleanup. Any OWNER role change or removal must cancel related PENDING invitations by UID/email in the same transaction; stale queued acceptance/join requests must be rejected after revalidation.'
}

Table category_invitations {
  id text [pk, not null, note: 'UUID generated by application']
  category_id text [not null]
  inviter_uid text [not null]
  invitee_email_key text [not null]
  invitee_uid text
  offered_role text [not null]
  status text [not null, default: 'PENDING']
  created_at integer [not null]
  expires_at integer [not null]
  server_updated_at integer
  deleted_at integer [note: 'NULL = active; category/task/subtask use trash and restore. Invitations and reminders also retain this nullable column for Room v3 compatibility.']
  revision integer [not null, default: 0]
  server_seq integer [not null, default: 0]

  indexes {
    (invitee_email_key, status) [name: 'idx_invites_email']
  }

  checks {
    `offered_role IN ('EDITOR','VIEWER')`
    `status IN ('PENDING','ACCEPTED','REJECTED','CANCELLED','EXPIRED')`
  }

  Note: 'CREATE UNIQUE INDEX uq_pending_invite ON category_invitations(category_id,invitee_email_key)  WHERE status=\'PENDING\'; V1 invitations are displayed in-app only, not delivered by sharing email or deep link. Verified token email must match invitee_email_key. Accept transaction rechecks expiry, status and membership; keep the role of an already ACTIVE member. Otherwise activate with offered_role. Replaying ACCEPTED must never reactivate REMOVED membership. OWNER role changes/removal cancel related PENDING invitations atomically. Reject self-invites and invites intended to change an ACTIVE role. Mark expired PENDING as EXPIRED before a replacement invite for the same key.'
}

Table tasks {
  id text [pk, not null, note: 'UUID generated by application']
  category_id text [not null]
  created_by_uid text [not null]
  title text [not null]
  description text
  due_at integer
  priority integer [not null, default: 2]
  is_done integer [not null, default: 0]
  completed_at integer
  repeat_type text [not null, default: 'NONE']
  timezone text [not null, default: 'Asia/Ho_Chi_Minh']
  repeat_anchor_day integer
  created_at integer [not null]
  client_updated_at integer [not null]
  server_updated_at integer
  deleted_at integer [note: 'NULL = active; category/task/subtask use trash and restore. Invitations and reminders also retain this nullable column for Room v3 compatibility.']
  revision integer [not null, default: 0]
  server_seq integer [not null, default: 0]

  indexes {
    (category_id, is_done, due_at) [name: 'idx_tasks_category_due']
    (category_id, id) [unique]
  }

  checks {
    `length(trim(title)) BETWEEN 1 AND 200`
    `priority IN (1,2,3)`
    `is_done IN (0,1)`
    `repeat_type IN ('NONE','DAILY','WEEKLY','MONTHLY')`
    `repeat_anchor_day BETWEEN 1 AND 31`
    `(is_done=0 AND completed_at IS NULL) OR (is_done=1 AND completed_at IS NOT NULL)`
  }

  Note: 'A task may have zero or multiple task_participants; creating/editing a task does not enroll other users. No user assigns another user. ACTIVE OWNER and EDITOR may each self-join or withdraw; OWNER inherits editing and self-join capability. Moving to trash preserves children. Only an OWNER can permanently delete the task and its descendants.'
}

Table task_participants {
  category_id text [not null]
  task_id text [not null]
  user_uid text [not null]
  joined_at integer [not null]
  server_updated_at integer
  revision integer [not null, default: 0]
  server_seq integer [not null, default: 0]

  indexes {
    (task_id, user_uid) [pk]
    (category_id, task_id) [name: 'idx_participants_task']
    (category_id, user_uid) [name: 'idx_participants_member']
  }

  Note: 'The composite foreign keys require the task and category membership to belong to the same category. Repository/backend bind user_uid to the authenticated actor and allow self-join/withdraw only for an ACTIVE OWNER or EDITOR; VIEWER cannot join. No OWNER or EDITOR may enroll or withdraw another user as an assignment action. Joining is idempotent by operation_id and the (task_id,user_uid) key; existing participation is not duplicated. A later voluntary rejoin after withdrawal uses a fresh operation_id; replaying an old join must not restore withdrawn participation. Membership removal/demotion cleanup is a separate authorized lifecycle action. Task/category/member DELETE physically cascades participants; no deletion status or business payload is retained.'
}

Table subtasks {
  id text [pk, not null, note: 'UUID generated by application']
  task_id text [not null]
  title text [not null]
  is_done integer [not null, default: 0]
  sort_order integer [not null, default: 0]
  client_updated_at integer [not null]
  server_updated_at integer
  deleted_at integer [note: 'NULL = active; category/task/subtask use trash and restore. Invitations and reminders also retain this nullable column for Room v3 compatibility.']
  revision integer [not null, default: 0]
  server_seq integer [not null, default: 0]

  indexes {
    task_id [name: 'idx_subtasks_task']
  }

  checks {
    `length(trim(title)) BETWEEN 1 AND 200`
    `is_done IN (0,1)`
  }
}

Table task_reminders {
  task_id text [not null]
  user_uid text [not null]
  remind_at integer [not null]
  is_enabled integer [not null, default: 1]
  client_updated_at integer [not null]
  server_updated_at integer
  deleted_at integer [note: 'NULL = active; category/task/subtask use trash and restore. Invitations and reminders also retain this nullable column for Room v3 compatibility.']
  revision integer [not null, default: 0]

  indexes {
    (task_id, user_uid) [pk]
  }

  checks {
    `is_enabled IN (0,1)`
  }

  Note: 'Per-user reminder settings. On each device: AlarmManager -> ReminderReceiver -> Android Notification with one short sound and short vibration, subject to notification permission and channel/user settings; never looping alarm-clock audio. Prefer inexact when sufficient; use exact only for a justified timing need and allowed permission, otherwise fall back to inexact and explain delay. WorkManager/SyncWorker handles synchronization and retries; optional overdue summaries may be delayed. Edit/disable/complete/delete cancels obsolete local alarms; rebuild valid future schedules on app start/resume, reboot and permission grant. Revoking SCHEDULE_EXACT_ALARM stops the app and cancels future exact alarms; immediate inexact fallback is not guaranteed before the app runs again. Undo completion restores exactly one alarm only if enabled, authorized and remind_at is in the future; past times require user rescheduling and never replay automatically. Sound/vibration are local Notification Channel settings, not business schema fields.'

}

Table sync_queue {
  operation_id text [pk, not null, note: 'UUID generated by application']
  actor_uid text [not null]
  category_id text [not null, note: 'No FK: temporary routing/checkpoint; remove after category DELETE acknowledgement']
  entity_type text [not null]
  entity_id text [not null, note: 'Stable UUID or canonical routing path/tuple for a nested/composite entity; DELETE retains identifiers only']
  action text [not null]
  payload_json text [note: 'CREATE/UPDATE business payload only; must be NULL for DELETE']
  base_revision integer [not null, default: 0]
  client_occurred_at integer [not null]
  status text [not null, default: 'PENDING']
  retry_count integer [not null, default: 0]
  last_error text
  next_retry_at integer
  predecessor_id text [note: 'Previous command on the same entity; cleared after ACK']
  dispatched integer [not null, default: 0, note: 'Once dispatched never rewrite the command payload']
  membership_revision integer [not null, default: 0, note: 'Membership revision at enqueue time; stale commands cannot cross a role change']

  indexes {
    (actor_uid, status, next_retry_at) [name: 'idx_outbox_pending']
  }

  checks {
    `action IN ('CREATE','UPDATE','DELETE')`
    `(action='DELETE' AND payload_json IS NULL) OR (action IN ('CREATE','UPDATE') AND payload_json IS NOT NULL)`
    `status IN ('PENDING','SENDING','ACKED','FAILED','REJECTED')`
  }

  Note: 'Temporary delivery outbox, not deleted business data. DELETE payload_json is NULL and identifiers provide minimal routing. Delete ACKED commands immediately; remove superseded/stale commands for physically deleted entities and descendants. UPDATE preserves the draft base_revision. On REVISION_CONFLICT mark REJECTED with last_error and retain its draft payload until user review/discard or a new command; do not auto-retry with a newer base.'
}

Table sync_state {
  user_uid text [not null]
  category_id text [not null, note: 'No FK: temporary routing/checkpoint; remove after category DELETE acknowledgement']
  last_server_seq integer [not null, default: 0]

  indexes {
    (user_uid, category_id) [pk]
  }

  Note: 'Synchronization checkpoint for an existing category or pending DELETE only. Remove after the category DELETE is acknowledged; remove immediately if its unsent CREATE is cancelled.'
}


Ref: categories.owner_uid > users.uid [delete: no action]
Ref: category_members.user_uid > users.uid [delete: no action]
Ref: category_members.category_id > categories.id [delete: cascade]
Ref: category_invitations.invitee_uid > users.uid [delete: no action]
Ref: category_invitations.inviter_uid > users.uid [delete: no action]
Ref: category_invitations.category_id > categories.id [delete: cascade]
Ref: tasks.created_by_uid > users.uid [delete: no action]
Ref: tasks.category_id > categories.id [delete: cascade]
Ref: task_participants.(category_id, task_id) > tasks.(category_id, id) [delete: cascade]
Ref: task_participants.(category_id, user_uid) > category_members.(category_id, user_uid) [delete: cascade]
Ref: subtasks.task_id > tasks.id [delete: cascade]
Ref: task_reminders.user_uid > users.uid [delete: no action]
Ref: task_reminders.task_id > tasks.id [delete: cascade]
Ref: sync_queue.actor_uid > users.uid [delete: no action]
Ref: sync_state.user_uid > users.uid [delete: no action]
