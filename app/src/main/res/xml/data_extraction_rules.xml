<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="file" path="account-avatars/" />
        <exclude domain="file" path="profile-avatar.jpg" />
        <exclude domain="sharedpref" path="account_session.xml" />
        <exclude domain="sharedpref" path="account_reminders.xml" />
        <exclude domain="sharedpref" path="notification_settings.xml" />
        <exclude domain="sharedpref" path="guest_profile.xml" />
        <!-- TODO: Use <include> and <exclude> to control what is backed up.
        <include .../>
        <exclude .../>
        -->
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="file" path="account-avatars/" />
        <exclude domain="file" path="profile-avatar.jpg" />
        <exclude domain="sharedpref" path="account_session.xml" />
        <exclude domain="sharedpref" path="account_reminders.xml" />
        <exclude domain="sharedpref" path="notification_settings.xml" />
        <exclude domain="sharedpref" path="guest_profile.xml" />
    </device-transfer>
</data-extraction-rules>
