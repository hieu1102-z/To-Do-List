<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:paddingHorizontal="26dp" android:paddingTop="28dp" android:paddingBottom="40dp"
    android:background="@drawable/bg_task_delete">
    <ScrollView android:id="@+id/content" android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/heading" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/task_delete_heading" android:textSize="22sp" android:textStyle="bold"
                android:textColor="@color/ink" android:includeFontPadding="false"/>
            <TextView android:id="@+id/message" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="18dp" android:textSize="16sp" android:textColor="@color/muted"
                android:lineSpacingMultiplier="1.6" android:includeFontPadding="false"/>
            <TextView android:id="@+id/error" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="@string/task_delete_failure" android:textSize="13sp"
                android:textColor="#BA4B56" android:visibility="gone" android:accessibilityLiveRegion="polite"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="48dp">
        <Button android:id="@+id/cancel" style="@style/TaskDeleteButton" android:layout_marginEnd="16dp"
            android:background="@drawable/bg_task_delete_cancel" android:textColor="@color/ink" android:text="@string/task_delete_cancel"/>
        <Button android:id="@+id/delete" style="@style/TaskDeleteButton" android:background="@drawable/bg_task_delete_confirm"
            android:text="@string/task_delete_confirm"/>
    </LinearLayout>
</LinearLayout>
