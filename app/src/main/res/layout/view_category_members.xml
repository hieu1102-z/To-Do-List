<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/heading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/category_members_heading"
                android:textColor="@color/ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/invite"
                style="@style/CategoryMembersAction"
                android:contentDescription="@string/category_members_invite"
                android:src="@drawable/ic_category_members_add"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/members"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/pendingMembers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/leave"
            style="@style/PrimaryButton"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_task_delete_cancel"
            android:backgroundTint="@null"
            android:minHeight="48dp"
            android:text="@string/category_members_leave"
            android:textColor="@color/task_delete_danger"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:paddingTop="8dp"
        android:textColor="@color/muted"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
