<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:gravity="center_vertical" android:orientation="horizontal">

    <TextView android:id="@+id/details" android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical"
        android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="10dp" android:paddingBottom="10dp"
        android:textColor="@color/editor_brand" android:textSize="14sp" />

    <ImageButton android:id="@+id/cancel" style="@style/CategoryMembersAction"
        android:src="@drawable/ic_editor_close" android:tint="@color/task_delete_danger"
        android:contentDescription="@string/category_members_cancel_invitation" />
</LinearLayout>
